# Shared by every Wonderhoy Labs repository. Change it in wonderhoy-labs/template first.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# YAML can't be indented with tabs.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown lists and code blocks are indented with spaces.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[{gradlew,gradlew.bat,*.properties}]
indent_style = space

[*.{kt,kts}]
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
